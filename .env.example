# 飞书自建应用凭证（真实值只填在本地 .env，本文件可进仓库）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 可选：学习库的根节点 token 或 wiki 链接。
# 填了它，看板上的「同步飞书笔记」按钮就会同步**整棵树**（父文档 + 全部子文档）；
# 不填，按钮只同步 notes/ 里最近同步过的那一篇（并会在结果里提示怎么改成全树）。
# 例：FEISHU_ROOT_DOC=NMq0wmqEDiRkiAk2d8acp7mHnVd
# 或：FEISHU_ROOT_DOC=https://<租户>.feishu.cn/wiki/NMq0wmqEDiRkiAk2d8acp7mHnVd
FEISHU_ROOT_DOC=

# LLM 配置：默认 Kimi Coding Plan（套餐额度），备用 DeepSeek（按量）
LLM_PROVIDER=kimi

# Kimi Coding Plan Key：在 Kimi Code 控制台创建（会员订阅含额度）
# 注意：与开放平台按量 Key（MOONSHOT_API_KEY）不通用，端点也不同
# 工具已按官方文档接入：provider=kimi 时优先用 KIMI_API_KEY 走 coding 端点，
# 该端点支持 OpenAI 兼容的 /chat/completions（2026-09-26 端点探测确认）
KIMI_API_KEY=
# 可选：需要走代理/自建网关时再填，留空则用默认 https://api.kimi.com/coding/v1
KIMI_BASE_URL=

# 备用：Kimi 开放平台按量 Key（端点 https://api.moonshot.cn/v1）
MOONSHOT_API_KEY=

DEEPSEEK_API_KEY=
